<Window x:Class="Dxf2Stl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF2STL" Height="700" Width="1040" MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Open DXF..." Width="105" Height="32" Click="Open_Click" DockPanel.Dock="Left"/>
            <TextBlock x:Name="FileNameText" Text="No DXF loaded" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Closed faces (Ctrl/Shift-click to select)" Grid.Column="0">
                <ListBox x:Name="ProfileList" SelectionMode="Extended"
                         SelectionChanged="ProfileList_SelectionChanged"
                         Margin="5" BorderThickness="0"/>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#D0D0D0"/>
            <GroupBox Header="2D preview" Grid.Column="2">
                <Canvas x:Name="PreviewCanvas" Background="#FAFAFA"
                        SizeChanged="PreviewCanvas_SizeChanged" ClipToBounds="True"/>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,8" Padding="10" BorderBrush="#D0D0D0"
                BorderThickness="1" CornerRadius="3">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Operation" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox x:Name="OperationCombo" Width="205" Height="28" Margin="0,0,18,0"
                          DisplayMemberPath="Name"
                          SelectionChanged="OperationCombo_SelectionChanged"/>
                <TextBlock x:Name="AmountLabel" Text="Extrusion distance" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBox x:Name="AmountText" Text="10" Width="88" Height="28" Margin="0,0,18,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock x:Name="AxisLabel" Text="Axis" VerticalAlignment="Center" Margin="0,0,7,0"
                           Visibility="Collapsed"/>
                <ComboBox x:Name="AxisCombo" Width="70" Height="28" SelectedIndex="1"
                          Visibility="Collapsed">
                    <ComboBoxItem Content="X"/>
                    <ComboBoxItem Content="Y"/>
                </ComboBox>
                <Button Content="Export STL..." Width="115" Height="32" Margin="18,0,0,0"
                        Click="Export_Click"/>
            </WrapPanel>
        </Border>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#555555"
                   Text="Open an ASCII DXF containing closed 2D polylines or circles."/>
    </Grid>
</Window>
